rules_version = '2';

// Canva Sınıfı Rezervasyon Sistemi - Firestore Güvenlik Kuralları
// Firebase Console > Firestore Database > Rules sekmesine bu dosyanın tamamını yapıştırıp "Publish" deyin.
//
// !!! AŞAĞIDAKİ E-POSTAYI kendi yönetici e-postanızla değiştirin (index.html'deki YONETICI_EPOSTA ile aynı).
// !!! Sınıf kapasitesini (30) ve saat bloklarını değiştirirseniz index.html'deki AYARLAR ile aynı yapın.

service cloud.firestore {
  match /databases/{database}/documents {

    function yonetici() {
      return request.auth != null
        && request.auth.token.email in ['yonetici@ornek.com'];
    }

    function metin(v, enAz, enCok) {
      return v is string && v.size() >= enAz && v.size() <= enCok;
    }

    function gecmisDegil(tarih) {
      let p = tarih.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) > request.time - duration.value(1, 'd');
    }

    // Herkese açık doluluk bilgisi (telefon / e-posta BURADA TUTULMAZ)
    match /rezervasyonlar/{slotId} {
      allow read: if true;

      // "create" sadece belge YOKSA çalışır -> aynı saate ikinci kayıt imkânsız.
      allow create: if request.resource.data.keys().hasOnly(['tarih', 'saat', 'grupId', 'adMaskeli', 'kurum', 'etkinlik', 'katilimci', 'olusturma'])
        && request.resource.data.tarih is string
        && request.resource.data.tarih.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && gecmisDegil(request.resource.data.tarih)
        && request.resource.data.saat in [9, 10, 11, 13, 14, 15, 16]
        && slotId == request.resource.data.tarih + '_' + string(request.resource.data.saat)
        && metin(request.resource.data.grupId, 5, 40)
        && metin(request.resource.data.adMaskeli, 1, 80)
        && metin(request.resource.data.kurum, 3, 120)
        && metin(request.resource.data.etkinlik, 3, 120)
        && request.resource.data.katilimci is int
        && request.resource.data.katilimci >= 1
        && request.resource.data.katilimci <= 30
        && request.resource.data.olusturma == request.time;

      allow update: if false;          // kayıtlar değiştirilemez
      allow delete: if yonetici();     // sadece yönetici iptal edebilir
    }

    // Gizli iletişim bilgileri (ad soyad + telefon/e-posta) - sadece yönetici okuyabilir
    match /iletisim/{grupId} {
      allow create: if request.resource.data.keys().hasOnly(['tarih', 'saatler', 'adSoyad', 'iletisim', 'kvkkOnay', 'olusturma'])
        && metin(request.resource.data.adSoyad, 3, 60)
        && metin(request.resource.data.iletisim, 5, 100)
        && request.resource.data.saatler is list
        && request.resource.data.saatler.size() >= 1
        && request.resource.data.saatler.size() <= 7
        && request.resource.data.kvkkOnay == true
        && request.resource.data.olusturma == request.time;
      allow read, delete: if yonetici();
      allow update: if false;
    }
  }
}
